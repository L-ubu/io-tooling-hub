# GitHub OAuth App credentials
# Create at: https://github.com/settings/developers
# Callback URL: http://localhost:4321/auth/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Secret for signing session JWTs (random 32+ character string)
AUTH_SECRET=

# GitHub PAT for AI submit endpoint (fine-grained, Contents + PRs read/write)
GITHUB_TOKEN=

# API key for the AI submit endpoint (random string)
SUBMIT_API_KEY=
