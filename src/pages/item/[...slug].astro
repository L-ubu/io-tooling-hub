---
import BaseLayout from '../../layouts/BaseLayout.astro';
import InstallButton from '../../components/InstallButton';
import CopyButton from '../../components/CopyButton';
import ConfigCard from '../../components/ConfigCard';
import AnimatedSection from '../../components/AnimatedSection';
import ToastContainer from '../../components/Toast';
import { render } from 'astro:content';
import { getAllItems } from '../../lib/collections';

export async function getStaticPaths() {
  const items = await getAllItems();
  return items.map((item) => ({
    params: { slug: `${item.category}/${item.id}` },
    props: { item, allItems: items },
  }));
}

const { item, allItems } = Astro.props;
const { Content } = await render(item);

// Related items: same category, excluding current
const relatedItems = allItems
  .filter((i: typeof item) => i.category === item.category && i.id !== item.id)
  .slice(0, 3);

// Items with shared tags from other categories
const crossCategoryItems = allItems
  .filter((i: typeof item) =>
    i.category !== item.category &&
    i.data.tags.some((t: string) => item.data.tags.includes(t))
  )
  .slice(0, 3);

const categoryLabels: Record<string, string> = {
  'cursor-rules': 'Cursor Rules',
  'mcp-configs': 'MCP Configs',
  'claude-files': 'Claude Files',
  plugins: 'Plugins & Extensions',
  skills: 'Skills',
};

const categoryIcons: Record<string, string> = {
  'cursor-rules': '📐',
  'mcp-configs': '🔌',
  'claude-files': '📄',
  plugins: '🧩',
  skills: '⚡',
};

const categoryColors: Record<string, { bg: string; border: string; text: string; gradient: string }> = {
  'cursor-rules': { bg: 'bg-purple-50', border: 'border-purple-200', text: 'text-purple-700', gradient: 'from-purple-600 to-indigo-600' },
  'mcp-configs': { bg: 'bg-blue-50', border: 'border-blue-200', text: 'text-blue-700', gradient: 'from-blue-600 to-cyan-600' },
  'claude-files': { bg: 'bg-amber-50', border: 'border-amber-200', text: 'text-amber-700', gradient: 'from-amber-500 to-orange-600' },
  plugins: { bg: 'bg-green-50', border: 'border-green-200', text: 'text-green-700', gradient: 'from-green-600 to-emerald-600' },
  skills: { bg: 'bg-rose-50', border: 'border-rose-200', text: 'text-rose-700', gradient: 'from-rose-500 to-pink-600' },
};

const difficultyConfig: Record<string, { bg: string; text: string; dot: string; label: string }> = {
  beginner: { bg: 'bg-green-100', text: 'text-green-700', dot: 'bg-green-500', label: 'Beginner' },
  intermediate: { bg: 'bg-amber-100', text: 'text-amber-700', dot: 'bg-amber-500', label: 'Intermediate' },
  advanced: { bg: 'bg-red-100', text: 'text-red-700', dot: 'bg-red-500', label: 'Advanced' },
};

const catColor = categoryColors[item.category] || categoryColors['plugins'];
const diff = difficultyConfig[item.data.difficulty] || difficultyConfig['beginner'];
---

<BaseLayout title={`${item.data.title} — iO Tooling Hub`} description={item.data.description}>
  <!-- Hero Header -->
  <div class={`relative overflow-hidden bg-gradient-to-br ${catColor.gradient} pb-32 pt-12`}>
    <!-- Background pattern -->
    <div class="absolute inset-0 opacity-[0.05]" style="background-image: radial-gradient(circle at 1px 1px, white 1px, transparent 0); background-size: 20px 20px;" />
    <div class="absolute -bottom-16 left-0 right-0 h-32 bg-gradient-to-t from-io-bg to-transparent" />

    <div class="relative max-w-5xl mx-auto px-4 sm:px-6 lg:px-8">
      <!-- Breadcrumb -->
      <AnimatedSection client:visible>
        <nav class="flex items-center gap-2 text-sm text-white/60 mb-8">
          <a href="/" class="hover:text-white transition-colors">Home</a>
          <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" /></svg>
          <a href={`/browse/${item.category}`} class="hover:text-white transition-colors">
            {categoryLabels[item.category]}
          </a>
          <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" /></svg>
          <span class="text-white font-medium truncate max-w-[200px]">{item.data.title}</span>
        </nav>
      </AnimatedSection>

      <!-- Title area -->
      <AnimatedSection client:visible delay={0.1}>
        <div class="flex flex-col lg:flex-row lg:items-end justify-between gap-6">
          <div class="flex-1">
            <div class="flex items-center gap-2.5 mb-4">
              <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-semibold bg-white/15 text-white backdrop-blur-sm border border-white/10">
                <span>{categoryIcons[item.category]}</span>
                {categoryLabels[item.category]}
              </span>
              <span class={`inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-semibold bg-white/15 text-white backdrop-blur-sm border border-white/10`}>
                <span class={`w-1.5 h-1.5 rounded-full ${diff.dot}`} />
                {diff.label}
              </span>
              {item.data.featured && (
                <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-bold bg-yellow-400/20 text-yellow-200 backdrop-blur-sm border border-yellow-400/20">
                  ⭐ Featured
                </span>
              )}
            </div>
            <h1 class="text-3xl sm:text-4xl lg:text-5xl font-extrabold text-white tracking-tight mb-3">
              {item.data.title}
            </h1>
            <p class="text-lg text-white/70 max-w-2xl">
              {item.data.description}
            </p>
          </div>
        </div>
      </AnimatedSection>
    </div>
  </div>

  <!-- Main content area (overlapping the hero) -->
  <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 -mt-20 relative z-10 pb-16">
    <div class="grid grid-cols-1 lg:grid-cols-3 gap-8">

      <!-- Main content column -->
      <div class="lg:col-span-2">
        <!-- Install Action Card -->
        <AnimatedSection client:visible delay={0.15}>
          <div class="bg-white rounded-2xl shadow-xl shadow-black/5 border border-io-gray-light/50 p-6 mb-6">
            <div class="flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4">
              <div>
                <h2 class="text-sm font-semibold text-io-text-muted uppercase tracking-wider mb-1">Quick Install</h2>
                <p class="text-sm text-io-text-muted">
                  {item.data.installType === 'mcp' && 'One click to add this MCP server to your IDE'}
                  {item.data.installType === 'cursor-rule' && 'Copy this rule into your .cursor/rules/ directory'}
                  {item.data.installType === 'claude-file' && 'Download and drop into your project root'}
                  {item.data.installType === 'plugin' && 'Install this extension in your IDE'}
                  {item.data.installType === 'skill' && 'Copy this skill to use in your AI assistant'}
                </p>
              </div>
              <div class="flex items-center gap-2 flex-shrink-0">
                {item.data.installType && (
                  <InstallButton
                    client:load
                    installType={item.data.installType}
                    installTarget={item.data.installTarget}
                    installCommand={item.data.installCommand}
                    cursorDeepLink={item.data.cursorDeepLink}
                    downloadFile={item.data.downloadFile}
                    extensionId={item.data.extensionId}
                    externalUrl={item.data.externalUrl}
                    title={item.data.title}
                    rawContent={item.body || ''}
                  />
                )}
              </div>
            </div>
            {item.data.installCommand && (
              <div class="mt-4 pt-4 border-t border-io-gray-light/50">
                <div class="flex items-center justify-between bg-io-surface-dark rounded-xl px-4 py-3">
                  <code class="text-sm text-green-400 font-mono truncate mr-3">{item.data.installCommand}</code>
                  <CopyButton client:load text={item.data.installCommand} label="" className="!px-2 !py-1 !bg-white/10 hover:!bg-white/20 !text-white !text-xs" />
                </div>
              </div>
            )}
          </div>
        </AnimatedSection>

        <!-- Article Content -->
        <AnimatedSection client:visible delay={0.2}>
          <div class="bg-white rounded-2xl shadow-xl shadow-black/5 border border-io-gray-light/50 p-8">
            <div class="detail-content">
              <Content />
            </div>
          </div>
        </AnimatedSection>
      </div>

      <!-- Sidebar -->
      <div class="lg:col-span-1 space-y-6">
        <!-- Meta Card -->
        <AnimatedSection client:visible delay={0.2}>
          <div class="bg-white rounded-2xl shadow-xl shadow-black/5 border border-io-gray-light/50 p-6">
            <h3 class="text-sm font-semibold text-io-text-muted uppercase tracking-wider mb-4">Details</h3>
            <dl class="space-y-4">
              <div>
                <dt class="text-xs text-io-text-muted mb-1">Author</dt>
                <dd class="text-sm font-semibold text-io-text flex items-center gap-2">
                  <div class="w-6 h-6 rounded-full bg-io-primary/10 flex items-center justify-center">
                    <span class="text-[10px] font-bold text-io-primary">{item.data.author.charAt(0)}</span>
                  </div>
                  {item.data.author}
                </dd>
              </div>
              <div>
                <dt class="text-xs text-io-text-muted mb-1">Category</dt>
                <dd>
                  <a href={`/browse/${item.category}`} class={`inline-flex items-center gap-1.5 px-2.5 py-1 rounded-lg text-xs font-medium ${catColor.bg} ${catColor.text} ${catColor.border} border hover:opacity-80 transition-opacity`}>
                    <span>{categoryIcons[item.category]}</span>
                    {categoryLabels[item.category]}
                  </a>
                </dd>
              </div>
              <div>
                <dt class="text-xs text-io-text-muted mb-1">Difficulty</dt>
                <dd>
                  <span class={`inline-flex items-center gap-1.5 px-2.5 py-1 rounded-lg text-xs font-medium ${diff.bg} ${diff.text}`}>
                    <span class={`w-1.5 h-1.5 rounded-full ${diff.dot}`} />
                    {diff.label}
                  </span>
                </dd>
              </div>
              <div>
                <dt class="text-xs text-io-text-muted mb-1">Added</dt>
                <dd class="text-sm text-io-text">{item.data.createdAt.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' })}</dd>
              </div>
              {item.data.updatedAt && item.data.updatedAt.getTime() !== item.data.createdAt.getTime() && (
                <div>
                  <dt class="text-xs text-io-text-muted mb-1">Updated</dt>
                  <dd class="text-sm text-io-text">{item.data.updatedAt.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' })}</dd>
                </div>
              )}
              {item.data.installTarget && item.data.installTarget.length > 0 && (
                <div>
                  <dt class="text-xs text-io-text-muted mb-1">Works with</dt>
                  <dd class="flex flex-wrap gap-1.5">
                    {item.data.installTarget.map((t: string) => (
                      <span class="inline-flex items-center px-2 py-0.5 rounded-md text-[11px] font-medium bg-io-gray-light text-io-gray-dark">
                        {t === 'cursor' ? '⌨️ Cursor' : t === 'claude-code' ? '🤖 Claude Code' : t === 'vscode' ? '💻 VS Code' : t}
                      </span>
                    ))}
                  </dd>
                </div>
              )}
            </dl>
          </div>
        </AnimatedSection>

        <!-- Tags Card -->
        <AnimatedSection client:visible delay={0.25}>
          <div class="bg-white rounded-2xl shadow-xl shadow-black/5 border border-io-gray-light/50 p-6">
            <h3 class="text-sm font-semibold text-io-text-muted uppercase tracking-wider mb-3">Tags</h3>
            <div class="flex flex-wrap gap-2">
              {item.data.tags.map((tag: string) => (
                <a href={`/browse/all`} class="px-3 py-1.5 rounded-lg text-xs font-medium bg-io-gray-light text-io-gray-dark hover:bg-io-primary/10 hover:text-io-primary transition-colors">
                  {tag}
                </a>
              ))}
            </div>
          </div>
        </AnimatedSection>

        <!-- Actions Card -->
        <AnimatedSection client:visible delay={0.3}>
          <div class="bg-white rounded-2xl shadow-xl shadow-black/5 border border-io-gray-light/50 p-6">
            <h3 class="text-sm font-semibold text-io-text-muted uppercase tracking-wider mb-3">Actions</h3>
            <div class="space-y-2">
              <CopyButton client:load text={item.body || ''} label="Copy full content" className="w-full justify-center !rounded-xl" />
              {item.data.externalUrl && (
                <a
                  href={item.data.externalUrl}
                  target="_blank"
                  rel="noopener"
                  class="flex items-center justify-center gap-2 w-full px-4 py-2 rounded-xl text-sm font-medium border border-io-gray-light text-io-gray-dark hover:border-io-primary/30 hover:text-io-primary transition-all"
                >
                  <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" /></svg>
                  View documentation
                </a>
              )}
            </div>
          </div>
        </AnimatedSection>
      </div>
    </div>

    <!-- Related Items -->
    {relatedItems.length > 0 && (
      <section class="mt-16">
        <AnimatedSection client:visible>
          <h2 class="text-2xl font-bold text-io-text mb-2">More in {categoryLabels[item.category]}</h2>
          <p class="text-io-text-muted mb-8">Other configs in the same category</p>
        </AnimatedSection>
        <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
          {relatedItems.map((rel: typeof item, i: number) => (
            <ConfigCard
              client:visible
              title={rel.data.title}
              description={rel.data.description}
              author={rel.data.author}
              category={rel.category}
              tags={rel.data.tags}
              difficulty={rel.data.difficulty}
              slug={rel.id}
              featured={rel.data.featured}
              index={i}
            />
          ))}
        </div>
      </section>
    )}

    <!-- Cross-category Related -->
    {crossCategoryItems.length > 0 && (
      <section class="mt-12">
        <AnimatedSection client:visible>
          <h2 class="text-2xl font-bold text-io-text mb-2">You might also like</h2>
          <p class="text-io-text-muted mb-8">Related configs from other categories</p>
        </AnimatedSection>
        <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
          {crossCategoryItems.map((rel: typeof item, i: number) => (
            <ConfigCard
              client:visible
              title={rel.data.title}
              description={rel.data.description}
              author={rel.data.author}
              category={rel.category}
              tags={rel.data.tags}
              difficulty={rel.data.difficulty}
              slug={rel.id}
              featured={rel.data.featured}
              index={i}
            />
          ))}
        </div>
      </section>
    )}
  </div>

  <ToastContainer client:load />
</BaseLayout>

<style is:global>
  /* Beautiful prose styling for detail content */
  .detail-content {
    color: #374151;
    line-height: 1.8;
    font-size: 1rem;
  }
  .detail-content h2 {
    font-size: 1.5rem;
    font-weight: 800;
    color: #111827;
    margin-top: 2.5rem;
    margin-bottom: 1rem;
    padding-bottom: 0.5rem;
    border-bottom: 2px solid #F3F4F6;
  }
  .detail-content h2:first-child {
    margin-top: 0;
  }
  .detail-content h3 {
    font-size: 1.2rem;
    font-weight: 700;
    color: #111827;
    margin-top: 2rem;
    margin-bottom: 0.75rem;
  }
  .detail-content p {
    margin-bottom: 1rem;
    color: #6B7280;
  }
  .detail-content a {
    color: #15208C;
    text-decoration: underline;
    text-underline-offset: 2px;
    transition: color 0.2s;
  }
  .detail-content a:hover {
    color: #6366F1;
  }
  .detail-content ul, .detail-content ol {
    margin-bottom: 1.25rem;
    padding-left: 1.5rem;
  }
  .detail-content li {
    margin-bottom: 0.5rem;
    color: #6B7280;
  }
  .detail-content li::marker {
    color: #15208C;
  }
  .detail-content strong {
    color: #111827;
    font-weight: 600;
  }
  .detail-content code:not(pre code) {
    background: #F3F4F6;
    color: #15208C;
    padding: 0.15rem 0.4rem;
    border-radius: 0.375rem;
    font-size: 0.875em;
    font-weight: 500;
  }
  .detail-content pre {
    background: #111827 !important;
    border-radius: 1rem;
    padding: 1.25rem 1.5rem;
    margin: 1.5rem 0;
    overflow-x: auto;
    border: 1px solid #1F2937;
    position: relative;
  }
  .detail-content pre code {
    background: none !important;
    color: #E5E7EB !important;
    padding: 0 !important;
    font-size: 0.85rem;
    line-height: 1.7;
  }
  .detail-content blockquote {
    border-left: 4px solid #15208C;
    background: #F9FAFB;
    padding: 1rem 1.25rem;
    border-radius: 0 0.75rem 0.75rem 0;
    margin: 1.5rem 0;
    color: #4B5563;
    font-style: italic;
  }
  .detail-content hr {
    border: none;
    border-top: 2px solid #F3F4F6;
    margin: 2rem 0;
  }
  .detail-content table {
    width: 100%;
    border-collapse: collapse;
    margin: 1.5rem 0;
    border-radius: 0.75rem;
    overflow: hidden;
    border: 1px solid #E5E7EB;
  }
  .detail-content th {
    background: #F9FAFB;
    padding: 0.75rem 1rem;
    text-align: left;
    font-weight: 600;
    font-size: 0.875rem;
    color: #374151;
    border-bottom: 2px solid #E5E7EB;
  }
  .detail-content td {
    padding: 0.75rem 1rem;
    font-size: 0.875rem;
    color: #6B7280;
    border-bottom: 1px solid #F3F4F6;
  }
  .detail-content tr:last-child td {
    border-bottom: none;
  }
  /* Checkbox list styling */
  .detail-content li input[type="checkbox"] {
    margin-right: 0.5rem;
    accent-color: #15208C;
  }
</style>
